generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlayerStatus {
  ONLINE
  OFFLINE
}

enum LobbyStatus {
  OPEN
  FULL
  IN_PROGRESS
  CLOSED
}

model Player {
  id         Int           @id @default(autoincrement())
  username   String        @unique
  email      String?       @unique
  status     PlayerStatus  @default(ONLINE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  memberships LobbyMember[]
  hostedLobbies Lobby[]    @relation("HostedLobbies")
}

model Lobby {
  id            Int           @id @default(autoincrement())
  lobbyCode     String        @unique
  lobbyName     String        @default("Untitled Lobby")
  hostPlayerId  Int
  hostPlayer    Player        @relation("HostedLobbies", fields: [hostPlayerId], references: [id])
  gameMode      String
  maxPlayers    Int
  status        LobbyStatus   @default(OPEN)
  isPrivate     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  members       LobbyMember[]
  gameSession   GameSession?
}

model LobbyMember {
  id        Int      @id @default(autoincrement())
  lobbyId   Int
  playerId  Int
  isReady   Boolean  @default(false)
  joinedAt  DateTime @default(now())
  lobby     Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, playerId])
}

model GameSession {
  id          Int      @id @default(autoincrement())
  lobbyId     Int      @unique
  lobby       Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  sessionCode String   @unique
  status      String
  createdAt   DateTime @default(now())
}
