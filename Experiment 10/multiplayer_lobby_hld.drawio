        </mxCell>
        <mxCell id="howTitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#4A90D9;" value="HOW EACH MAJOR COMPONENT WORKS" vertex="1">
          <mxGeometry height="20" width="400" x="340" y="670" as="geometry" />
        </mxCell>
        <mxCell id="comp1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#9B59B6;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;arcSize=8;" value="&lt;b&gt;1. Backend API&lt;/b&gt;&lt;br&gt;Handles all client REST requests, validates JWT, and forwards to appropriate services." vertex="1">
          <mxGeometry height="80" width="195" x="340" y="695" as="geometry" />
        </mxCell>
        <mxCell id="comp2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#9B59B6;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;arcSize=8;" value="&lt;b&gt;2. WebSocket Server&lt;/b&gt;&lt;br&gt;Maintains persistent connections with clients, subscribes players to lobby rooms, and broadcasts real-time events." vertex="1">
          <mxGeometry height="80" width="195" x="545" y="695" as="geometry" />
        </mxCell>
        <mxCell id="comp3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#27AE60;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;arcSize=8;" value="&lt;b&gt;3. Lobby Service&lt;/b&gt;&lt;br&gt;Core of the system. Manages lobby lifecycle, members, host, readiness, and validates game start conditions." vertex="1">
          <mxGeometry height="80" width="195" x="750" y="695" as="geometry" />
        </mxCell>
        <mxCell id="comp4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#27AE60;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;arcSize=8;" value="&lt;b&gt;4. Matchmaking Service&lt;/b&gt;&lt;br&gt;Places players in a queue based on criteria (skill, region, mode). When enough players are found, creates a lobby." vertex="1">
          <mxGeometry height="80" width="195" x="955" y="695" as="geometry" />
        </mxCell>
        <mxCell id="comp5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#27AE60;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;arcSize=8;" value="&lt;b&gt;5. Game Session Service&lt;/b&gt;&lt;br&gt;Creates game session after lobby is ready and returns game room / session details." vertex="1">
          <mxGeometry height="80" width="195" x="1160" y="695" as="geometry" />
        </mxCell>
        <mxCell id="comp6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#27AE60;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;arcSize=8;" value="&lt;b&gt;6. Notification / Chat Service&lt;/b&gt;&lt;br&gt;Handles lobby chat and system notifications, sends messages via WebSocket to players." vertex="1">
          <mxGeometry height="80" width="195" x="1365" y="695" as="geometry" />
        </mxCell>
        <mxCell id="keyFlowsTitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=1;fontColor=#4A90D9;" value="KEY FLOWS" vertex="1">
          <mxGeometry height="20" width="1600" x="50" y="840" as="geometry" />
        </mxCell>
        <mxCell id="flowA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#4A90D9;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;arcSize=8;" value="&lt;b&gt;A. Login Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Player enters credentials&lt;br&gt;2. Backend API → Auth Service&lt;br&gt;3. Auth Service validates with DB&lt;br&gt;4. JWT token returned to Client" vertex="1">
          <mxGeometry height="110" width="280" x="50" y="870" as="geometry" />
        </mxCell>
        <mxCell id="flowB" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#4A90D9;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;arcSize=8;" value="&lt;b&gt;B. Create / Join Lobby Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Client → Backend API&lt;br&gt;2. API → Lobby Service&lt;br&gt;3. Lobby Service → DB + Redis&lt;br&gt;4. WebSocket notifies lobby members" vertex="1">
          <mxGeometry height="110" width="280" x="350" y="870" as="geometry" />
        </mxCell>
        <mxCell id="flowC" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#27AE60;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;arcSize=8;" value="&lt;b&gt;C. Ready / Unready Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Client sends ready status&lt;br&gt;2. Lobby Service updates state&lt;br&gt;3. State saved in Redis + DB&lt;br&gt;4. WebSocket broadcasts update" vertex="1">
          <mxGeometry height="110" width="280" x="650" y="870" as="geometry" />
        </mxCell>
        <mxCell id="flowD" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#27AE60;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;arcSize=8;" value="&lt;b&gt;D. Matchmaking Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Client requests Quick Match&lt;br&gt;2. Matchmaking Service queues player&lt;br&gt;3. Match found (enough players)&lt;br&gt;4. Creates lobby via Lobby Service&lt;br&gt;5. Notifies players via WebSocket" vertex="1">
          <mxGeometry height="110" width="280" x="950" y="870" as="geometry" />
        </mxCell>
        <mxCell id="flowE" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;strokeColor=#E74C3C;fontColor=#FFFFFF;fontSize=10;verticalAlign=top;arcSize=8;" value="&lt;b&gt;E. Start Game Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Host requests start game&lt;br&gt;2. Lobby Service validates&lt;br&gt;3. Game Session Service creates session&lt;br&gt;4. Lobby state → IN_PROGRESS&lt;br&gt;5. WebSocket notifies all players" vertex="1">
          <mxGeometry height="110" width="280" x="1250" y="870" as="geometry" />
        </mxCell>
